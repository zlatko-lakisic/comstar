# Copy to ~/.config/comstar/google.env on the Pi (chmod 600). Never commit secrets.

# TV / limited-input client — hallway QR pairing (calendar + drive.file)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Desktop client — Gmail + full Drive via email upgrade link after TV pairing
GOOGLE_DESKTOP_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_SECRET=

# Public HTTPS origin (Cloudflare/proxy → Pi :8781). No trailing slash.
# Register: ${COMSTAR_OAUTH_REDIRECT_BASE}/oauth/google/callback
COMSTAR_OAUTH_REDIRECT_BASE=https://comstar.mostardesigns.com
COMSTAR_OAUTH_BIND_LAN=1

# SMTP for the HTML Desktop-upgrade email (bridge-owned, not AO)
COMSTAR_SMTP_HOST=
COMSTAR_SMTP_PORT=587
COMSTAR_SMTP_TLS=starttls
COMSTAR_SMTP_USER=
COMSTAR_SMTP_PASSWORD=
COMSTAR_SMTP_FROM=comstar@example.com
COMSTAR_SMTP_FROM_NAME=COMSTAR
