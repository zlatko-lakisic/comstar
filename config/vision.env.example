# Local Ada secrets / runtime — never commit.
# Copy to config/vision.env on Ada and fill secrets.

COMSTAR_CPAI_URL=http://127.0.0.1:32168
COMSTAR_VISION_FRAME_URL=http://127.0.0.1:5000/api/front_door/latest.jpg
COMSTAR_FRIGATE_URL=http://127.0.0.1:5000
COMSTAR_MCP_HTTP=1
COMSTAR_TZ=America/New_York
COMSTAR_VISIT_CAMERA=driveway
COMSTAR_VISIT_MAX_UNKNOWN=5

# Prefer HA LLM Vision (same stack as driveway notifications):
# HOME_ASSISTANT_URL=https://ha.example.com
# HOME_ASSISTANT_TOKEN=
# Optional OpenAI fallback (gpt-4o-mini):
# OPENAI_API_KEY=
# Local fallback (always available on Ada if Ollama has moondream):
COMSTAR_OLLAMA_URL=http://127.0.0.1:11434
COMSTAR_OLLAMA_VISION_MODEL=moondream

# On the Pi bridge (systemd drop-in), point at Ada — IP is OK for HTTP client:
# COMSTAR_VISION_MCP_URL=http://10.0.10.16:8793/mcp
