# Mac host device picks for COMSTAR.
# Copy to comstar.mac.env (gitignored) and edit:
#   cp config/comstar.mac.env.example config/comstar.mac.env
#   set -a && source config/comstar.mac.env && set +a

# ffmpeg AVFoundation index (list: ffmpeg -f avfoundation -list_devices true -i "")
COMSTAR_CAMERA_SOURCE='avfoundation:1'

# sounddevice / CoreAudio input name substring
COMSTAR_MIC_SOURCE='HD Webcam C525'

# Empty = system default speakers. Browser kiosk uses Chromium audio.
COMSTAR_SPEAKER_SOURCE=''

COMSTAR_VISION=1
COMSTAR_LOCAL_SPEAKER=1
COMSTAR_ENV=dev
COMSTAR_STT_URL='http://127.0.0.1:8090'
COMSTAR_TTS_URL='http://127.0.0.1:8091'
