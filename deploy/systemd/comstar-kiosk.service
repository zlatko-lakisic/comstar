[Unit]
Description=COMSTAR kiosk (Chromium avatar renderer)
After=network-online.target comstar-bridge.service
Wants=network-online.target comstar-bridge.service

[Service]
Type=simple
WorkingDirectory=/opt/comstar/src/terminal/kiosk
Environment=COMSTAR_LOG=info
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/bin/bash /opt/comstar/src/scripts/kiosk-launch.sh
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=2
# M9.3 — Chromium is heavy; cap before OOM-killer takes the session
MemoryMax=1200M
CPUQuota=200%

[Install]
WantedBy=default.target
