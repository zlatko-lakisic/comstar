[Unit]
Description=COMSTAR bridge
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=all
WatchdogSec=60
WorkingDirectory=/opt/comstar/src/terminal/bridge
Environment=COMSTAR_CONFIG=/opt/comstar/src/config/comstar.yaml
Environment=COMSTAR_CPAI_URL=http://10.0.10.16:32168
# Camera: /dev/video0 on Pi, or e.g. avfoundation:0 on Mac
Environment=COMSTAR_CAMERA_SOURCE=/dev/video0
Environment=COMSTAR_CAMERA_INPUT=/dev/video0
Environment=COMSTAR_VISION=1
Environment=COMSTAR_LOG=info
Environment=COMSTAR_LOCAL_SPEAKER=1
# PipeWire sink for paplay (also used when kiosk is connected — Chromium is silent on Pulse).
Environment=COMSTAR_SPEAKER_SOURCE=comstar_hdmi
# Fallback when Ada speech is off / Mac bring-up (optional once Ada proven)
Environment=COMSTAR_STT_URL=http://127.0.0.1:8090
Environment=COMSTAR_TTS_URL=http://127.0.0.1:8091
# When AO advertises hello.speech, pin better Ada sidecars via Reach overrides:
# Environment=COMSTAR_SPEECH_OVERRIDE=1
# Environment=COMSTAR_STT_URL=http://10.0.10.16:8093
# Environment=COMSTAR_TTS_URL=http://10.0.10.16:8092
# Or dedicated: COMSTAR_STT_OVERRIDE / COMSTAR_TTS_OVERRIDE
# Optional when Ada sets AGENTIC_SPEECH_TOKEN:
# Environment=COMSTAR_SPEECH_TOKEN=
Environment=PATH=/opt/comstar/bin:/usr/local/bin:/usr/bin:/bin
Environment=LD_LIBRARY_PATH=/opt/comstar/bin
Environment=XDG_RUNTIME_DIR=/run/user/1000
ExecStart=/usr/local/bin/dart run bin/comstar_bridge.dart --config /opt/comstar/src/config/comstar.yaml
Restart=on-failure
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=5
TimeoutStartSec=120
# M9.3 resource limits (Pi 4B 4GB)
MemoryMax=768M
CPUQuota=200%

[Install]
WantedBy=default.target
