[Unit]
Description=COMSTAR local STT (faster-whisper)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/comstar/src
ExecStart=/opt/comstar/.venv-stt/bin/python scripts/stt_server_whisper.py --host 127.0.0.1 --port 8090 --model tiny --beam-size 5
Restart=on-failure
RestartSec=5
Environment=COMSTAR_WHISPER_MODEL=tiny
Environment=COMSTAR_WHISPER_BEAM=5
Environment=OMP_NUM_THREADS=2
# Opt-in utterance WAV archives (M9.7 privacy default: off)
# Environment=COMSTAR_STT_ARCHIVE=1
# M9.3 resource limits
MemoryMax=512M
CPUQuota=100%

[Install]
WantedBy=default.target
