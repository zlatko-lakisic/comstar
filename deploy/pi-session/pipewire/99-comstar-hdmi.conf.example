# OPTIONAL exclusive HDMI sink (NOT the default path).
#
# Preferred path: WirePlumber ACP sink renamed to comstar_hdmi via
# deploy/pi-session/wireplumber/51-comstar-hdmi.lua + prefer-hdmi-audio.sh.
#
# A hard-failing context.object takes down all of PipeWire (status 234).
# Only enable after you have verified the path works, e.g.:
#   CARD=$(awk -F'[][]' '/vc4hdmi0/{print $2; exit}' /proc/asound/cards)
#   # then set api.alsa.path = "hdmi:${CARD}" and api.alsa.card = ${CARD}
#
# Install (manual):
#   mkdir -p ~/.config/pipewire/pipewire.conf.d
#   cp this file → ~/.config/pipewire/pipewire.conf.d/99-comstar-hdmi.conf
#   # edit card index for THIS boot
#   systemctl --user restart pipewire pipewire-pulse wireplumber
#
# Bind by ALSA card *index* only after resolving vc4hdmi0 from /proc/asound/cards.
# Headphones often steals card 0, so api.alsa.path = "hdmi:0" breaks.
# Named paths like "hdmi:CARD=vc4hdmi0,DEV=0" fail spa.alsa ("Could not
# determine card index") and kill PipeWire.
#
# Do NOT use:
#   - hdmi:0 / hdmi:1 without checking /proc/asound/cards first
#   - default:CARD=vc4hdmi0 / hdmi:CARD=… without api.alsa.card (PW exit 234)
#   - hw:/plughw: alone — vc4 HDMI is IEC958_SUBFRAME_LE only
#
# If this file is active, keep ACP HDMI profiles off via prefer-hdmi-audio.sh
# (dual-open breaks playback). With the default ACP+rename path, primary
# HDMI profile must stay ON.

# context.objects = [
#   { factory = adapter
#     args = {
#       factory.name = api.alsa.pcm.sink
#       node.name = "comstar_hdmi"
#       node.description = "COMSTAR HDMI"
#       media.class = "Audio/Sink"
#       api.alsa.path = "hdmi:1"
#       api.alsa.card = 1
#       audio.rate = 48000
#       audio.channels = 2
#       session.suspend-timeout-seconds = 0
#       node.pause-on-idle = false
#     }
#   }
# ]
