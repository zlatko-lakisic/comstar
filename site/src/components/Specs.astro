---
const specs = [
  ['Terminal', 'Raspberry Pi 4 Model B, 4 GB'],
  ['Form', 'Lab bring-up: HDMI panel with the Pi nearby. No finished enclosure or wall mount yet.'],
  ['Power (terminal)', 'Roughly 8 to 12 W for Pi, panel, and speakers. The GPU host is separate and much higher.'],
  ['Camera', 'UVC webcam (bring-up: Logitech C525): vision only'],
  ['Microphone', 'Dedicated array preferred (ReSpeaker Lite / XMOS); webcam mic for bring-up only'],
  ['Display', 'HDMI panel, roughly 800×480 to 1280×720'],
  ['Audio out', 'HDMI or powered speakers, played by the kiosk browser'],
  ['AI server', 'NVIDIA GPU host: CodeProject.AI, agentic-orchestration, preferred speech sidecars'],
  ['Ports (Pi)', 'Bridge HTTP :8776 · kiosk WS :8777 · audio WS :8778'],
  ['Ports (AI server)', 'Orchestration :8765 · CodeProject.AI :32168 · STT :8090 · TTS :8091'],
  ['Languages', 'Dart (bridge) · Python (audio, speech) · Chromium kiosk'],
  ['Licence', 'Apache-2.0'],
];
---
<section class="section" id="specs">
  <div class="wrap reveal">
    <h2>Specifications</h2>
    <table class="specs">
      <tbody>
        {specs.map(([k, v]) => (
          <tr>
            <th scope="row">{k}</th>
            <td>{v}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
