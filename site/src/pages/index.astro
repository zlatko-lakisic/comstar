---
import { execSync } from 'node:child_process';
import { dirname, join } from 'node:path';
import { fileURLToPath } from 'node:url';
import Hero from '../components/Hero.astro';
import Sequence from '../components/Sequence.astro';
import Utterances from '../components/Utterances.astro';
import Identity from '../components/Identity.astro';
import Capabilities from '../components/Capabilities.astro';
import Privacy from '../components/Privacy.astro';
import Presets from '../components/Presets.astro';
import Build from '../components/Build.astro';
import Status from '../components/Status.astro';
import BuiltOn from '../components/BuiltOn.astro';
import FAQ from '../components/FAQ.astro';
import Specs from '../components/Specs.astro';
import '../styles/comstar.css';

const siteUrl = 'https://zlatko-lakisic.github.io/comstar/';
const title = 'COMSTAR · It knows who just walked in';
const description =
  'An always-on AI terminal for one room in your house. It sees you, greets you by name, listens when you speak, and answers out loud. Open source, about $200 in parts.';

const repoRoot = join(dirname(fileURLToPath(import.meta.url)), '../../..');
let lastCommit = '';
try {
  lastCommit = execSync('git log -1 --format=%cd --date=short', {
    cwd: repoRoot,
    encoding: 'utf8',
  }).trim();
} catch {
  lastCommit = '';
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#06080B" />
    <link rel="canonical" href={siteUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${siteUrl}media/og.png`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}media/og.png`} />

    <link rel="icon" href={`${import.meta.env.BASE_URL}media/favicon.svg`} type="image/svg+xml" />

    <script async src="https://www.googletagmanager.com/gtag/js?id=G-05JM8NN139" is:inline></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-05JM8NN139');
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <nav class="sticky-nav" id="sticky-nav" aria-label="Section">
      <div class="sticky-nav__inner wrap-wide">
        <a class="sticky-nav__brand" href="#hero">COMSTAR</a>
        <div class="sticky-nav__links">
          <a href="#capabilities" data-nav-section="capabilities">Capabilities</a>
          <a href="#privacy" data-nav-section="privacy">Privacy</a>
          <a href="#build" data-nav-section="build">Build</a>
          <a href="#status" data-nav-section="status">Status</a>
          <a href="#faq" data-nav-section="faq">FAQ</a>
          <a href="https://github.com/zlatko-lakisic/comstar" rel="noopener noreferrer">GitHub</a>
        </div>
        <a class="sticky-nav__cta btn btn-primary" href="#build">Build one</a>
      </div>
    </nav>

    <header class="hero" id="hero">
      <div class="wrap hero-inner">
        <Hero />
        <h1>It knows who just walked in.</h1>
        <p class="hero-sub">
          An always-on AI terminal for one room in your house. It sees you,
          greets you by name, listens when you speak, and answers out loud.
          Runs on your own hardware, on a home server with a GPU.
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href="#build">Build one</a>
          <a class="btn btn-ghost" href="#sequence">How it works</a>
          <a
            class="btn btn-ghost"
            href="https://github.com/zlatko-lakisic/comstar"
            rel="noopener noreferrer"
          >GitHub</a>
        </div>
        <p class="hero-meta">Open source · Apache-2.0 · about $200 in parts</p>
        <p class="hero-ip">
          Personal, non-commercial project. "ComStar" and the starburst are
          BattleTech IP, used affectionately.
        </p>
      </div>
    </header>

    <main id="main">
      <Sequence />
      <Utterances />
      <Identity />
      <Capabilities />
      <Privacy />
      <Presets />
      <Build />
      <Status lastCommit={lastCommit} />
      <BuiltOn />
      <FAQ />
      <Specs />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <nav aria-label="Footer">
          <a href="https://github.com/zlatko-lakisic/comstar">GitHub</a>
          <a href="https://github.com/zlatko-lakisic/comstar/wiki">Docs</a>
          <a href="#build">Build</a>
          <a href="#faq">FAQ</a>
          <a href="#specs">Specs</a>
        </nav>
        {lastCommit && (
          <p class="activity">
            Last commit: {lastCommit} · Roughly three quarters through the first phase ·{' '}
            <a href="https://github.com/zlatko-lakisic/comstar/wiki/Progress-Tracker">tracker</a>
          </p>
        )}
        <p class="tm-note">
          Apache-2.0. Not a mystical AI. A tool you engineered.
          "ComStar" and the ComStar starburst are BattleTech IP
          (Topps / Catalyst Game Labs), used affectionately in a personal,
          non-commercial project.
        </p>
      </div>
    </footer>

    <script type="module" src={`${import.meta.env.BASE_URL}product.js`}></script>
  </body>
</html>
